# Public browser configuration, embedded during npm run build.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server configuration for authenticated requests (same project and public key).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional: only needed for admin operations or database tooling.
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=
# CRON_SECRET=
# CRON_SECRET_PREVIOUS=
# PORT=3000
